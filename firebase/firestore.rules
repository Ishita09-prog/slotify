rules_version = '2';

// Slotify security model
// - Anyone can read lots, slots and zones (public availability data).
// - Only the FastAPI backend (Admin SDK, bypasses rules) writes slot status, bookings and wallets.
// - Drivers read their own wallet and bookings; owners read their lots' bookings;
//   police (custom claim role == "police") read violations.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function isOwnerOf(lotId) {
      return role() == "owner" && get(/databases/$(db)/documents/parking_lots/$(lotId)).data.owner_id == request.auth.uid;
    }

    match /parking_lots/{lotId} {
      allow read: if true;
      allow update: if isOwnerOf(lotId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["price_per_hour", "open_hours", "features"]);

      match /slots/{slotId} {
        allow read: if true;
        // Owners may toggle maintenance directly; everything else goes through the API.
        allow update: if isOwnerOf(lotId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updated_at"])
          && request.resource.data.status in ["available", "maintenance"];
      }
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid || isOwnerOf(resource.data.lot_id)
      );
    }

    match /fastag_wallets/{vehicle} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      match /transactions/{txnId} {
        allow read: if signedIn()
          && get(/databases/$(db)/documents/fastag_wallets/$(vehicle)).data.user_id == request.auth.uid;
      }
    }

    match /violations/{id} {
      allow read: if role() == "police";
      allow update: if role() == "police"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]);
    }

    match /zones/{id} { allow read: if true; }
    match /detections/{id} { allow read: if role() in ["owner", "police"]; }
    match /users/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; }
  }
}
