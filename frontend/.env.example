# Optional: FastAPI backend. Leave empty to run fully on the built-in simulator.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Firebase (enables live slot sync from Firestore via onSnapshot)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: free CARTO basemap key (https://carto.com/basemaps/apikey). Without it, Esri/OSM tiles are used.
NEXT_PUBLIC_CARTO_KEY=
